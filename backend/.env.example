APP_NAME=AmazonHackon Backend
APP_ENV=development
API_V1_PREFIX=/api/v1

# Add one of these later when the LLM provider is finalized.
OPENAI_API_KEY=
AWS_REGION=
BEDROCK_MODEL_ID=

# Public URL used in Discord buttons and OAuth callbacks.
# For local Discord Interactions, expose FastAPI with ngrok or Cloudflare Tunnel.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Google Classroom OAuth app credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback

# Discord integration.
# Webhook URL is enough to post daily prompts. Public key is needed to verify button interactions.
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
